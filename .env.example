# MongoDB Atlas Configuration
# Get these values from your MongoDB Atlas dashboard
NEXT_PUBLIC_MONGODB_APP_ID=
NEXT_PUBLIC_MONGODB_API_KEY=
NEXT_PUBLIC_MONGODB_CLUSTER_NAME=
NEXT_PUBLIC_MONGODB_DB_NAME=
NEXT_PUBLIC_MONGODB_COLLECTION_NAME=

# Base Path Configuration
# Set this if deploying to a subdirectory (e.g., /student-search)
# Leave empty for root deployment
NEXT_PUBLIC_BASE_PATH=
